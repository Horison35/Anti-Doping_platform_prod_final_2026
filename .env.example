# Шаблон секретов (STRUCTURE.md). Скопируйте и заполните:  cp .env.example .env
# .env обязан быть в .gitignore — ключи и строки подключения не коммитятся (правило 6).

# PostgreSQL (docker-compose.yml, СЛОЙ 3)
POSTGRES_USER=antidoping
POSTGRES_PASSWORD=change_me_strong
POSTGRES_DB=antidoping
POSTGRES_PORT=5432

# Строка подключения для загрузчиков, API и хостовых скриптов (systemd) —
# те же параметры, что выше; host=localhost, т.к. POSTGRES_PORT проброшен
# на 127.0.0.1 из контейнера db (api-контейнер использует свой DATABASE_URL
# с host=db — задаётся docker-compose.yml, этот .env не трогает).
DATABASE_URL=postgresql://antidoping:change_me_strong@localhost:5432/antidoping

# API / веб-платформа (СЛОЙ 4/5, docker-compose.yml)
APP_PASSWORD=change_me_platform_password
# Секрет подписи сессионной куки — сгенерировать: openssl rand -hex 32
SESSION_SECRET=change_me_random_hex_32_bytes
SESSION_MAX_AGE_DAYS=30
# true в проде (HTTPS обязателен для secure-куки); false только для локальной разработки без TLS
COOKIE_SECURE=true
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
CORS_ORIGINS=
API_PORT=8000
FRONTEND_PORT=8080

# АД-Монитор (monitor/run_daily.sh) — headless `claude -p`, ПОДПИСКА Claude
# Code (OAuth-сессия хоста через ~/.claude), не платный API. Эта переменная
# сознательно НЕ используется run_daily.sh/summarize_digest.py — если она
# задана в окружении, скрипты останавливаются (защита от случайного платного пути).
ANTHROPIC_API_KEY=
AD_MONITOR_WINDOW_DAYS=4

# Автопереобучение (ml/retrain.py) — минимальная доля Lift@20 кандидата от
# действующей версии, при которой кандидат промоутируется (1.0 = кандидат
# обязан быть строго не хуже; 0.95 — допуск на шум малых выборок)
RETRAIN_MIN_LIFT_RATIO=0.95

# DuckDNS (бесплатный поддомен для HTTPS-ссылки, DEPLOY.md) — токен и имя
# поддомена берутся на https://www.duckdns.org после входа
DUCKDNS_SUBDOMAIN=antidoping-platform
DUCKDNS_TOKEN=
